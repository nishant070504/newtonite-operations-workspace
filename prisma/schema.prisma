generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  TEAM_LEAD
  ADMIN
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  DEPLOYED
}

enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String
  createdAt      DateTime         @default(now())
  teamMemberships TeamMember[]
  assignedIssues Issue[]          @relation("Assignee")
  activities     IssueActivity[]
  idempotencyKeys IdempotencyKey[]

  @@map("users")
}

model Team {
  id        String       @id @default(uuid())
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  issues    Issue[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId, role])
  @@map("team_members")
}

model Issue {
  id          String         @id @default(uuid())
  key         String         @unique
  teamId      String
  title       String
  description String         @default("")
  status      IssueStatus    @default(TODO)
  priority    IssuePriority  @default(MEDIUM)
  version     Int            @default(1)
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assigneeId  String?
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignee    User?          @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities  IssueActivity[]

  @@index([teamId, status, updatedAt])
  @@index([assigneeId, status, updatedAt])
  @@map("issues")
}

model IssueActivity {
  id        String   @id @default(uuid())
  issueId   String
  actorId   String
  action    String
  fromValue String?
  toValue   String?
  metadata  Json?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
  @@map("issue_activities")
}

model IdempotencyKey {
  idempotencyKey String   @id
  userId        String
  operation     String
  response      Json
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, operation, createdAt])
  @@map("idempotency_keys")
}
